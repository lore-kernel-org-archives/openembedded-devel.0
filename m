++static void str8100_setup_timer(unsigned int counter_value)
++{
++	unsigned long control_value;
++	unsigned long mask_value;    
++
++	control_value = TIMER1_TIMER2_CONTROL_REG;
++	mask_value = TIMER1_TIMER2_INTERRUPT_MASK_REG;
