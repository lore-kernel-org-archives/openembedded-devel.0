+ 	if (!res) {
+@@ -276,6 +342,18 @@ static int __devinit atmel_tsadcc_probe(struct plat=
form_device *pdev)
+=20
+ 	prsc =3D (prsc / (2 * pdata->adc_clock)) - 1;
+=20
++#if defined(CONFIG_MACH_AT91SAM9M10G45EK)
++	trigger_period =3D pdata->adc_clock / (200 * COUNT_MAX) -1;
