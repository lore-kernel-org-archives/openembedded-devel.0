 		(type, host, path, user, pswd, parm) = bb.decodeurl(url)
+
+		local = None
+		base, ext = os.path.splitext(os.path.basename(path))
+		if ext in ('.gz', '.bz2', '.Z'):
+			local = os.path.join(workdir, base)
+			ext = os.path.splitext(base)[1]
+
 		apply = parm.get("apply")
