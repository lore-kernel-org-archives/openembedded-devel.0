++  ASSERT_TRUE(pipe.ReadLine(line));
++  ASSERT_EQ(line, "One");
++  ASSERT_TRUE(pipe.ReadLine(line));
++  ASSERT_EQ(line, "Two");
++  ASSERT_TRUE(pipe.ReadLine(line));
++  ASSERT_EQ(line, "Three");
++  ASSERT_FALSE(pipe.ReadLine(line));
++}
