++		shift = (where & 0x3) << 3;
++		local_irq_save(flags);
++		__raw_writel(CONFIG_CMD(bus->number, devfn, where), pci_config_addr);
++		v = __raw_readl(pci_config_data);
++		local_irq_restore(flags);
++		v = (v >> shift) & 0xffff;
++
++		break;
++
++	case 4:
++		local_irq_save(flags);
++		__raw_writel(CONFIG_CMD(bus->number, devfn, where), pci_config_addr);
++		v = __raw_readl(pci_config_data);
++		local_irq_restore(flags);
++		break;
++	}
