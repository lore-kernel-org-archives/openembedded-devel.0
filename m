-+	if (ret) {
-+		printk("Unable to grab IRQ for %s: %d\n", jornada720_ts_name, ret);
-+		input_free_device(dev);
-+		return ret;
-+	}
-+
-+	input_register_device(dev);
-+
-+	return 0;
-+}
-+
