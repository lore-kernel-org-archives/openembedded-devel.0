> ++#
> ++# Print "ok" on success and "not ok" on error
> ++#
> ++# Note: Every time this function is called it will be counted
> ++# as a unit test.
> ++#
> ++# Args: $com:            The actual command run. Will be printed on a f=
ailure
> ++#       $verbose:        Be more verbose.
> ++#       $iteration:      Number of iterations in a loop when the error
> ++#                        occurred. If not in loop, this should be blank
> ++#                        (e.g. send zero).
> ++#       $expected_error: Optional; put here expected error code. Test
> ++#                        will pass with this result only.
> ++#
> ++# Return value:          Will return 1 on success and 0 on an error
> ++#
> ++
> ++sub ok
> ++{
> ++  my ($com, $verbose, $iteration, $expected_error)=3D @_;
> ++  my ($msg, $output, $err, $errcode, $len);
> ++
> ++  $test_counter++;
> ++  if ($test_begin > $test_counter)
> ++  {
> ++    return 0;
> ++  }
> ++  if ($test_end && $test_end < $test_counter)
> ++  {
> ++    exit(0);
> ++  }
> ++
> ++  $msg=3D "";
> ++  $expected_error=3D 0 if (!defined($expected_error));
> ++
> ++  if ($verbose)
> ++  {
> ++    # Print command with out the long unittest/../ prefix=20
> ++    my $tmp;
> ++    $tmp=3D $com;
> ++    $tmp =3D~ s|^unittest/../||;
> ++    print "$tmp ";
> ++    $len=3D length($tmp);
> ++  }
> ++  $output=3D `$com 2>&1`;
> ++  if ($verbose)
> ++  {
> ++    print " " x (62 - $len);
> ++  }
> ++  $err=3D $?;
> ++  $errcode=3D ($? >> 8);
> ++  if ((!$err && !$expected_error) ||
> ++      ($errcode =3D=3D $expected_error && $expected_error))
> ++  {
> ++    print "[ " if ($verbose);
> ++    print "ok";
> ++    if ($verbose)
> ++    {
> ++      print " ]";
> ++      print " " x (5 - length("$test_counter"));
> ++      print "$test_counter";
> ++    }
> ++    else
> ++    {
> ++      print " $test_counter - $com"
> ++    }
> ++    print "\n";
> ++    return 1;
> ++  }
> ++  print "[ " if ($verbose);
> ++  print "not ok";
> ++  print " ]" if ($verbose);
> ++  print " $test_counter - $com" unless $verbose;
> ++  print "\n";
> ++  if ($verbose && defined($output) && length($output))
> ++  {
> ++    print "$output\n";
> ++  }
> ++  if (!$verbose)
> ++  {
> ++    $msg=3D "\n"; # Get a nicer output in perl unit test mode
> ++  }
> ++  $msg.=3D "Failed test '$com' ";
> ++  if ($iteration)
> ++  {
> ++    $msg.=3D "(loop iteration $iteration.) ";
> ++  }
> ++  $msg.=3D "at line ";
> ++  $msg.=3D (caller)[2];
> ++  $msg.=3D "\n(errcode: $errcode, test: $test_counter)\n";
> ++  if ($expected_error)
> ++  {
> ++    $msg.=3D "Was expecting errcode: $expected_error\n";
> ++  }
> ++  warn $msg;
> ++  $runtime_error=3D 1;
> ++  if ($opt_abort_on_error)
> ++  {
> ++    exit 1;
> ++  }
> ++  return 0;
> ++}
