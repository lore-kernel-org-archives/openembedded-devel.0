++	dbg_cmd (ehci, "reset", command);
++	ehci_writel(ehci, command, &ehci->regs->command);
++	ehci_to_hcd(ehci)->state = HC_STATE_HALT;
++	ehci->next_statechange = jiffies;
++	retval = handshake (ehci, &ehci->regs->command,
++			    CMD_RESET, 0, 250 * 1000);
