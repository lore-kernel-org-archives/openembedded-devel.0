-+	switch (rx.state) {
-+	case STATE_SOF:	/* Looking for SOF */
-+		if (ch == CHAR_SOF)
-+			rx.state = STATE_ID; /* Next byte is the id and len */
-+		/* else
-+			g_statistics.missing_sof++;  // FIXME */
-+		break;
