-+	sg_len = size / period;
-+
-+	for (i = 0; i < sg_len; i++) {
-+		dsg = kzalloc(sizeof(*dsg), GFP_NOWAIT);
-+		if (!dsg) {
-+			s3c24xx_dma_free_txd(txd);
