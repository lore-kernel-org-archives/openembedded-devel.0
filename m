++	if (ctepr == 0) {
++		if (ax_local->tx_curr_page == ax_local->tx_start_page && ax_local->tx_prev_ctepr == 0)
++			free_pages = TX_PAGES;
++		else
++			free_pages = ax_local->tx_stop_page - ax_local->tx_curr_page;
++	}
++	else if (ctepr < ax_local->tx_curr_page - 1) {
++		free_pages = ax_local->tx_stop_page - ax_local->tx_curr_page + 
