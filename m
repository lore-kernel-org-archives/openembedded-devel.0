-cr.patch \
+           "
+SRCREV =3D "0ae0d797d11e18a045b2d383e47a097181b4062b"
+
+UPSTREAM_CHECK_URI =3D "https://gitlab.gnome.org/GNOME/loupe/-/tags"
+UPSTREAM_CHECK_REGEX =3D "(?P<pver>\d+(\.\d+)+)"
+
+require ${BPN}-crates.inc
+
+DEPENDS =3D " \
+    cairo \
+    desktop-file-utils \
+    fontconfig \
+    gdk-pixbuf \
+    glib-2.0 \
+    glib-2.0-native \
+    graphene \
+    gtk4 \
+    hicolor-icon-theme \
+    libadwaita \
+    libgweather4 \
+    libseccomp \
+    pango \
+"
+
+do_write_config:append:class-target() {
+	cat > ${WORKDIR}/meson-rust.cross <<-EOF
+	[properties]
+	rust_target =3D '${RUST_HOST_SYS}'
+	EOF
+}
+
+EXTRA_OEMESON:append:class-target =3D " --cross-file ${WORKDIR}/meson-ru=
st.cross"
