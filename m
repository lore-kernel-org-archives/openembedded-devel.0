++		if (p && insert_resource(p, r)) {
++			printk(KERN_ERR
++			       "%s: failed to claim resource %d\n",
++			       dev_name(&pdev->dev), i);
++			ret = -EBUSY;
++			goto failed;
++		}
++	}
