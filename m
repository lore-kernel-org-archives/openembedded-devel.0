++			(u32 __iomem *)(((u8 *)ehci->regs) + USBMODE_EX));
++		ehci_writel(ehci, TXFIFO_DEFAULT,
++			(u32 __iomem *)(((u8 *)ehci->regs) + TXFILLTUNING));
++	}
++	if (retval)
++		return retval;
