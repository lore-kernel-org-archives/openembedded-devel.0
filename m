+From 2685cc0bef0200733b634932ea7399b6cf91b6d7 Mon Sep 17 00:00:00 2001
+From: Petr P=EDsa=F8 <ppisar@redhat.com>
+Date: Thu, 19 Oct 2023 08:42:59 +0000
+Subject: [PATCH] Fix a heap buffer overwrite in search_brace()
+ (CVE-2023-40305)
+MIME-Version: 1.0
+Content-Type: text/plain; charset=3DUTF-8
+Content-Transfer-Encoding: 8bit
+
+If there was a comment between if-condition and an statement opening
+bracket and the comment size aligned to an indent-internal 1024 B
+buffer for comments, indent attempted to write into a nonallocated
+memory on heap.
+
+$ hexdump -C /tmp/write1
+00000000  69 66 20 30 3b 65 6c 73  65 2f 2a 0a 0a 0a 0a 0a  |if 0;else/*..=
...|
+00000010  0a 0a 0a 0a 0a 0a 0a 0a  0a 0a 0a 0a 0a 0a 0a 0a  |.............=
...|
+*
+00000800  0a 0a 0a 0a 2a 2f 7b 0a                           |....*/{.|
+00000808
+
+$ valgrind -- ./indent -o /dev/null /tmp/write1 2>&1 | head -n 23
+=3D=3D26345=3D=3D Memcheck, a memory error detector
+=3D=3D26345=3D=3D Copyright (C) 2002-2022, and GNU GPL'd, by Julian Seward=
 et al.
+=3D=3D26345=3D=3D Using Valgrind-3.21.0 and LibVEX; rerun with -h for copy=
right info
+=3D=3D26345=3D=3D Command: ./indent -o /dev/null /tmp/write1
+=3D=3D26345=3D=3D
+=3D=3D26345=3D=3D Invalid write of size 1
+=3D=3D26345=3D=3D    at 0x401558: search_brace (indent.c:232)
+=3D=3D26345=3D=3D    by 0x401CB2: indent_main_loop (indent.c:548)
+=3D=3D26345=3D=3D    by 0x402288: indent (indent.c:758)
+=3D=3D26345=3D=3D    by 0x402931: indent_single_file (indent.c:1003)
+=3D=3D26345=3D=3D    by 0x4029FF: indent_all (indent.c:1041)
+=3D=3D26345=3D=3D    by 0x402BA6: main (indent.c:1122)
+=3D=3D26345=3D=3D  Address 0x4aa7830 is 0 bytes after a block of size 2,04=
8 alloc'd
+=3D=3D26345=3D=3D    at 0x4847A40: realloc (vg_replace_malloc.c:1649)
+=3D=3D26345=3D=3D    by 0x408BA1: xrealloc (globs.c:64)
+=3D=3D26345=3D=3D    by 0x40BEE4: need_chars (handletoken.c:89)
+=3D=3D26345=3D=3D    by 0x401686: search_brace (indent.c:281)
+=3D=3D26345=3D=3D    by 0x401CB2: indent_main_loop (indent.c:548)
+=3D=3D26345=3D=3D    by 0x402288: indent (indent.c:758)
+=3D=3D26345=3D=3D    by 0x402931: indent_single_file (indent.c:1003)
+=3D=3D26345=3D=3D    by 0x4029FF: indent_all (indent.c:1041)
+=3D=3D26345=3D=3D    by 0x402BA6: main (indent.c:1122)
+
+The cause was that the buffer was exhausted by the comment text and no
+space left for the following new-line and curly bracket characters.
+
+This patch fixes it by enlarging the buffer two fit these two
+additional characters.
+
+<https://savannah.gnu.org/bugs/index.php?64503>
