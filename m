-+	/*
-+	 * Ensure that we leave the bus in I2C stop mode.
-+	 */
-+	setclk(adap, 1);
-+	setdat(adap, 1);
-+	setmode(adap, 0);
-+	setdatin(adap);
-+
-+	return num;
-+}
