++	/*
++	 * Number of ticks since last interrupt
++	 */
++	ticks1 = timer_counter_value - ticks2;
++
++	/*
++	 * Interrupt pending?  If so, we've reloaded once already.
++	 */
++	if (interrupt_status) {
++		ticks1 += timer_counter_value;
++	}
++
++	/*
++	 * Convert the ticks to usecs
++	 */
++	return TICKS2USECS(ticks1);
