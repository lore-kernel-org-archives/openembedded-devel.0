-+static struct dma_async_tx_descriptor *s3c24xx_dma_prep_dma_cyclic(
-+	struct dma_chan *chan, dma_addr_t addr, size_t size, size_t period,
-+	enum dma_transfer_direction direction, unsigned long flags,
