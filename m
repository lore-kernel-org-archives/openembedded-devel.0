-+				   ori at, %lo(label) ; jmp at */
-+  /* Conditional branch.  */
-+  {BYTE_F, BYTE_B, 4, 4},	/* br{cond} label (label is in range) */
-+  /* Conditional jmp.  */
-+  {ABS, ABS, 16, 0},		/* br{opp_cond} skip ; movhi at, %hi(label) ;
-+				   ori at, %lo(label) ; jmp at ; skip: } */
-+};
