++			WRITE_FIFO (ax_base + EN0_DATAPORT, *((u16 *)(buf + i)));
++		}
++	}
++#endif
++	dma_start = jiffies;
++	while ((readb(ax_base + EN0_ISR) & 0x40) == 0) {
++		if (jiffies - dma_start > 2*HZ/100) {		/* 20ms */
