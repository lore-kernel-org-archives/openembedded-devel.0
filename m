++static int ax_probe (struct net_device *dev)
++{
++	int i;
++	int reg0, ret;
++	unsigned long base_addr;
++	void	*address;
++	struct ax_device *ax_local;
++
++	PRINTK (INIT_MSG,  PFX " probe start ..........\n");
