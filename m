++++ autofs-5.0.7/lib/Makefile	2013-02-04 13:42:19.954107635 -0800
+@@ -75,3 +75,4 @@
+ clean:
+ 	rm -f $(LIB) $(RPCS) $(OBJS) $(YACCSRC) *.output *~
+ 
++$(OBJS): $(RPCS)
