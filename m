-+u8 inline jornada720_mcu_reverse(u8 x)
-+{
-+	/* byte ghijklmn becomes nmlkjihg (line 205 of HP's doc) */
-+	return 
-+		((0x80 & x) >> 7) |
-+		((0x40 & x) >> 5) |
-+		((0x20 & x) >> 3) |
-+		((0x10 & x) >> 1) |
-+		((0x08 & x) << 1) |
-+		((0x04 & x) << 3) |
