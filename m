++	/* defer till later if busy */
++	if (ehci->reclaim) {
++		struct ehci_qh		*last;
++
++		for (last = ehci->reclaim;
++				last->reclaim;
++				last = last->reclaim)
++			continue;
++		qh->qh_state = QH_STATE_UNLINK_WAIT;
++		last->reclaim = qh;
++
++	/* start IAA cycle */
++	} else
++		start_unlink_async (ehci, qh);
++}
