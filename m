++
++	/*  Fix AGC  */
++	agc_data = 0xd0 | (agc_data << 9);
++	star_nic_write_phy(port, 15, agc_data);
++	udelay(1000);
++	star_nic_read_phy(port, 15, &reg);
++	reg &= ~(0x1 << 7);
++	star_nic_write_phy(port, 15, reg);
