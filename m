++  auto res = mock_compare_tuple<I - 1>(lhs, rhs);
++
++  if (res != 0)
++    return res;
++
++  return mock_compare_arg(std::get<I>(lhs), std::get<I - 1>(rhs)) ? 0 : I;
++}
