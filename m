-+		if (i == 0) {
-+			pr_err("%swrite_fifo: write failure\n", pszMe);
-+			usbd_info.stats.ep0_fifo_write_failures++;
-+		}
-+
-+		wr.p++;
-+		bytes_written++;
-+	}
