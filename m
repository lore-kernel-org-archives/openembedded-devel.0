> +        ln -sf ${UBOOT_INITIAL_ENV}-${MACHINE}-${PV}-${PR} ${D}/${sysconfdir}/${UBOOT_INITIAL_ENV}
>      fi
>
>      if [ -n "${UBOOT_ELF}" ]
> @@ -243,7 +247,7 @@ PACKAGE_BEFORE_PN += "${PN}-env"
