++
++      /* We create a machine dependent frag which can grow
++         to accommodate the largest possible instruction sequence
++         this may generate.  */
++      f = frag_var (rs_machine_dependent,
++		    RELAX_MAX_SIZE (CBRANCH),
++		    RELAX_SIZE (CBRANCH),
++		    RELAX_SUBSTATE (CBRANCH), symp, offset, NULL);
