++			retValue |= (1 << i);
++		writeb (EEPROM_SELECT | EEPROM_DIR_IN | EEPROM_SHIFT_CLK, ax_base + AX88796_MII_EEPROM);
++	}
++
++	writeb (0, ax_base + AX88796_MII_EEPROM);
++
++	return retValue;
++}
