+index 04b834b..2da986c 100644
+--- a/Makefile.am
++++ b/Makefile.am
+@@ -131,5 +131,4 @@ dist-hook:
+ 	rm -f $(distdir)/gram.h
+ 	rm -f $(distdir)/scanner.c
+ 
+-scanner.o: gram.h
+-
++scanner.c: gram.h
