++	strlcpy(proxy->modalias, chip->modalias, sizeof(proxy->modalias));
++	proxy->dev.platform_data = (void *) chip->platform_data;
++	proxy->controller_data = chip->controller_data;
++	proxy->controller_state = NULL;
