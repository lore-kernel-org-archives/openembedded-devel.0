-+	ucb1x00_reg_write(ucb, UCB_IE_RIS, 0);
-+	ucb1x00_reg_write(ucb, UCB_IE_FAL, 0);
-+	ucb1x00_reg_write(ucb, UCB_IE_CLEAR, 0xffff);
-+	ucb1x00_reg_write(ucb, UCB_IE_CLEAR, 0);
-+
-+	/*
-+	 * Read triggered interrupt.
-+	 */
-+	return probe_irq_off(mask);
-+}
