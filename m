++	retval = spi_write_read_sync(spi, &write_data, 1, &rx_data, 1);
++	write_data = 0x00;
++	retval = spi_write_read_sync(spi, &write_data, 1, &rx_data, 1);
++	write_data = 0x00;
++	retval = spi_write_read_sync(spi, &write_data, 1, &rx_data, 1);
