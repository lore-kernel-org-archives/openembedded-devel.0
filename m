++	info.si_signo = SIGILL;
++	info.si_errno = 0;
++	info.si_code  = ILL_ILLTRP;
++	info.si_addr  = (void __user *)instruction_pointer(regs) -
++			 (thumb_mode(regs) ? 2 : 4);
++
++	arm_notify_die("Oops - bad syscall", regs, &info, n, 0);
++
++	return regs->ARM_r0;
