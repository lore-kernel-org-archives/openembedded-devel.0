++	lwz	r5, 0(r3)
++	stw	r5, 0(r4)
++	addi	r3, r3, 4
++	addi	r4, r4, 4
++	bdnz	1b
++
++	/* Copy the jump to 0x0 code at 0x500*/
++	lwz	r5, 0x500(r6)
++	stw	r5, 0(r6)
++	lwz	r5, 8(r6)
++	stw	r5, 0x500(r6)
++
++	/* Flush the cache */
++	lis	r3, CONFIG_KERNEL_START@h
++	ori	r3, r3, CONFIG_KERNEL_START@l
++
++	/* Let us load data starting from 0x600 loc */
++	addi	r3, r3, 0x600
++	li	r4, NUM_CACHE_LINES
++	mtctr	r4
++1:
++	lwz	r4, 0(r3)
++	addi	r3, r3, L1_CACHE_BYTES    /* Next line, please */
++	bdnz	1b
