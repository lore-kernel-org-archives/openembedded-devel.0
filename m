+
+export CARGO_NET_OFFLINE =3D "1"
+export CARGO_BUILD_JOBS =3D "${@oe.utils.cpu_count()}"
+export RUSTFLAGS
+
+PACKAGECONFIG ??=3D "${@bb.utils.filter('DISTRO_FEATURES', 'x11', d)}"
