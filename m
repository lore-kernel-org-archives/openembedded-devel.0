-+md_number_to_chars (char *buf, valueT val, int n)
-+{
-+  gas_assert (n == 1 || n == 2 || n == 4);
-+  if (target_big_endian)
-+    {
-+      number_to_chars_bigendian (buf, val, n);
-+    }
-+  else
-+    {
-+      number_to_chars_littleendian (buf, val, n);
-+    }
