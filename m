++struct mpc5121_rtc_data {
++	unsigned irq;
++	unsigned irq_periodic;
++	struct mpc5121_rtc_regs __iomem *regs;
++	struct rtc_device *rtc;
++	struct rtc_wkalrm wkalarm;
++};
