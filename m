++      else
++        insn = (unsigned long) bfd_getl32 (buffer);
++      status = nios2_disassemble (address, insn, info);
++    }
++  else
++    {
++      (*info->memory_error_func) (status, address, info);
++      status = -1;
++    }
++  return status;
++}
