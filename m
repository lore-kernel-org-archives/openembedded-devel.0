-+}
-+
-+proc run_list_test { name  } {
-+    global srcdir subdir
-+    set testname "NIOS2 $name"
-+    set file $srcdir/$subdir/$name
-+    gas_run ${name}.s "" ">&dump.out"
-+    if { [regexp_diff "dump.out" "${file}.l"] } then {
-+	fail $testname
-+	verbose "output is [file_contents "dump.out"]" 2
-+	return
-+    }
-+    pass $testname
-+}
