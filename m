++	startup_time =3D (60 * pdata->adc_clock) / (8 * 1000000) - 1;
++	if (startup_time < 1)
++		startup_time =3D 1;
++#else
++	trigger_period =3D  0x0FFF;
++	startup_time =3D 0x26;
++#endif
