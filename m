-+static int
-+can_evaluate_expr (void)
-+{
-+  /* Remove this check for null and the invalid insn "ori r9, 1234" seg faults. */
-+  if (!insn.insn_reloc)
-+    {
-+      /* ??? Ideally we should do something other than as_fatal here as we can
