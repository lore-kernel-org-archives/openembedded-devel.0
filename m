diff --git a/meta-oe/recipes-devtools/gcc/gcc-4.6/arm-unbreak-eabi-armv4t.dpatch b/meta-oe/recipes-devtools/gcc/gcc-4.6/arm-unbreak-eabi-armv4t.dpatch
