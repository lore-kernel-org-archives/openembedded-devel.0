++	unionfs_mntget(file->f_path.dentry, bstart);
++	lower_file =
++		dentry_open(lower_dentry,
++			    unionfs_lower_mnt_idx(file->f_path.dentry, bstart),
++			    lower_flags, current_cred());
++	if (IS_ERR(lower_file))
++		return PTR_ERR(lower_file);
