-+static void core_kicker(void)
-+{
-+	u32 car = Ser0UDCAR;
-+	u32 imp = Ser0UDCIMP;
-+	u32 omp = Ser0UDCOMP;
-+
-+	UDC_set(Ser0UDCCR, UDCCR_UDD);
-+	udelay(300);
-+	UDC_clear(Ser0UDCCR, UDCCR_UDD);
-+
-+	Ser0UDCAR = car;
-+	Ser0UDCIMP = imp;
-+	Ser0UDCOMP = omp;
