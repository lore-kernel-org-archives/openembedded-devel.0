++ */
++static void set_multicast_list (struct net_device *dev)
++{
++	unsigned long flags;
++	struct ax_device *ax_local = (struct ax_device*)dev->priv;
++	
++	spin_lock_irqsave (&ax_local->page_lock, flags);
