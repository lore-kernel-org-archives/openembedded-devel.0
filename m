diff --git a/meta-oe/recipes-devtools/breakpad/breakpad/0030-minidump-2-core-Use-exception-context-for-crashed-th.patch b/meta-oe/recipes-devtools/breakpad/breakpad/0030-minidump-2-core-Use-exception-context-for-crashed-th.patch
new file mode 100644
index 000000000..656bc4c9e
--- /dev/null
