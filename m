diff --git a/recipes-kernel/linux/linux-handheld-4.4/locomo/0015-video-backlight-drop-old-locomo-bl-lcd-driver.patch b/recipes-kernel/linux/linux-handheld-4.4/locomo/0015-video-backlight-drop-old-locomo-bl-lcd-driver.patch
