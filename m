-+/*--- manage messages from Atmel Micro  ---*/
-+
-+static struct micro_private_t micro;
-+
-+static void h3600_micro_rx_msg(int id, int len, unsigned char *data)
-+{
-+	int i;
-+
-+	/*printk(KERN_ERR "h3600_micro : got a message from micro\n");*/
