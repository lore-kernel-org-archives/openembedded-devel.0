++	struct mt4 *ts = container_of(work, struct mt4, work.work);
++	struct i2c_adapter *adapter = to_i2c_adapter(ts->client->dev.parent);
++	struct ts_point pt[4];
++	int i, fingers = 0;
++	u8 data_length;
++	int event = EVENT_PENUP;
