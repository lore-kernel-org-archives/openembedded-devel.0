-+	while (1) {
-+		Ser0UDCCR |= UDCCR_RESIM; /* mask future resume events */
-+		udelay(i);
-+		if (Ser0UDCCR & UDCCR_RESIM || (Ser0UDCSR & UDCSR_RSTIR))
-+			break;
-+		if (++i == 50) {
-+			WARNING(&the_controller,
