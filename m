-+		rtc_next_alarm_time(&alarm_tm, &now_tm, alrm);
-+		ret = rtc_tm_to_time(&alarm_tm, &time);
-+		if (ret != 0)
-+			break;
-+
-+		RTSR = RTSR & (RTSR_HZE|RTSR_ALE|RTSR_AL);
-+		RTAR = time;
