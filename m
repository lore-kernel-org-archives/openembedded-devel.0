,048 free'd
+=3D=3D21830=3D=3D    at 0x4847A40: realloc (vg_replace_malloc.c:1649)
+=3D=3D21830=3D=3D    by 0x408BC0: xrealloc (globs.c:64)
+=3D=3D21830=3D=3D    by 0x40BF03: need_chars (handletoken.c:89)
+=3D=3D21830=3D=3D    by 0x401433: sw_buffer (indent.c:149)
+=3D=3D21830=3D=3D    by 0x401973: search_brace (indent.c:380)
