++      && !unsignedp0
++      && TYPE_UNSIGNED (TREE_TYPE (op0)))
++    primop0 = op0;
++  if (TYPE_PRECISION (TREE_TYPE (primop1)) < TYPE_PRECISION (TREE_TYPE (op1))
++      && TYPE_PRECISION (TREE_TYPE (op1)) < TYPE_PRECISION (*restype_ptr)
++      && !unsignedp1
++      && TYPE_UNSIGNED (TREE_TYPE (op1)))
