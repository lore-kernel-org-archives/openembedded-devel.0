-+			break;
-+		}
-+	}
-+	i = 0;
-+	while (1) {
-+		Ser0UDCCR &= ~UDCCR_SUSIM;
-+		udelay(i);
-+		if ((Ser0UDCCR & UDCCR_SUSIM) == 0
-+			|| (Ser0UDCSR & UDCSR_RSTIR))
-+			break;
-+		if (++i == 50) {
