++u32 str8100_query_map_desc_by_phy(u32 addr)
++{
++	struct map_desc *map;
++	int i;
++	u32 ret_addr = 0;
++	for (i = 0; i < str8100_map_desc_count; i++) {
++		map = &str8100_map_desc[i];
++		if (addr >= (map->pfn << PAGE_SHIFT) && addr < ((map->pfn << PAGE_SHIFT) + map->length)) {
