-+		dev->saved_state = (unsigned char *)s;
-+	}
-+
-+	if (s) {
-+		s->mccr0 = Ser4MCCR0;
-+		s->mccr1 = Ser4MCCR1;
-+	}
-+
-+	if (level == SUSPEND_DISABLE)
