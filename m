++
++	buf = kmalloc(SPI_BUFSIZ, GFP_KERNEL);
++	if (!buf) {
++		status = -ENOMEM;
++		goto err0;
++	}
++
++	status = bus_register(&spi_bus_type);
++	if (status < 0)
++		goto err1;
++
++	status = class_register(&spi_master_class);
++	if (status < 0)
++		goto err2;
++	return 0;
++
++err2:
++	bus_unregister(&spi_bus_type);
++err1:
++	kfree(buf);
++	buf = NULL;
++err0:
++	return status;
++}
