-+	while (count > 0) {
-+		audio_buf_t *b = &s->buffers[s->usr_frag];
-+
-+		/* Grab a fragment */
-+		if (file->f_flags & O_NONBLOCK) {
-+			ret = -EAGAIN;
-+			if (down_trylock(&s->sem))
-+				break;
-+		} else {
-+			ret = -ERESTARTSYS;
-+			if (down_interruptible(&s->sem))
-+				break;
-+		}
