++			case	NAND_CTRL_ALE:
++						chip->IO_ADDR_R = nandaddr_for_ale;
++						chip->IO_ADDR_W = nandaddr_for_ale;
++						break;
++			default	:
++						chip->IO_ADDR_R = nandaddr_for_data;
++						chip->IO_ADDR_W = nandaddr_for_data;
++						break;
++		}
++	}
