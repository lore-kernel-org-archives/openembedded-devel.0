-+static int udc_clear_opr(void)
-+{
-+	int i = 10000;
-+	int is_clear;
-+
-+	/*FIXME*/
-+	do {
-+		Ser0UDCCS0 = UDCCS0_SO;
-+		is_clear = !(Ser0UDCCS0 & UDCCS0_OPR);
-+		if (i-- <= 0)
