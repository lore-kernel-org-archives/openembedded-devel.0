+-module_init(locomokbd_init);
+-module_exit(locomokbd_exit);
++MODULE_AUTHOR("John Lenz <lenz@cs.wisc.edu>");
++MODULE_DESCRIPTION("LoCoMo keyboard driver");
++MODULE_LICENSE("GPL");
++MODULE_ALIAS("platform:locomo-kbd");
