++	unsigned char tmp;
++	int i;
++
++	// issue a "SB OP Addr" command
++	for (i = 8; i >= 0 ; i--) {
++		tmp = (cmd & (1 << i)) == 0 ? EEPROM_DATA_WRITE0 : EEPROM_DATA_WRITE1;
++		writeb (tmp | EEPROM_SELECT, ax_base + AX88796_MII_EEPROM);
++		writeb (tmp | EEPROM_SELECT | EEPROM_SHIFT_CLK, ax_base + AX88796_MII_EEPROM);
++	}
++
