++	hash_insert (nios2_opcode_hash, nios2_opcodes[i].name,
++		     (PTR) & nios2_opcodes[i]);
++      if (inserted != NULL)
++	{
++	  fprintf (stderr, _("internal error: can't hash `%s': %s\n"),
++		   nios2_opcodes[i].name, inserted);
