-+    // This is typically used to convert GL_RGBA into GL_BGRA.
-+    // Also, we need to use GL_UNSIGNED_BYTE when the format is GL_BGRA.
-+    internalFormat = externalFormat;
-+    if (pixel_type == GL_UNSIGNED_INT_8_8_8_8_REV)
