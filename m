#!/bin/sh

printf "%-30s" "# obj file"
printf " %10s" "size-4.1.2"
printf " %10s" "size-4.4.2"
printf " %10s" "difference"
printf "\n"

TOT1=3D0
TOT2=3D0
TOTDIFF=3D0

FILES=3D$(find gen-blob-with-gcc-4.1.2/ -name "*.o")
for file in $FILES;
do=20
  NAME=3D$(echo $file | cut -d '/' -f 2-)
  SIZE1=3D$(stat -c "%s" gen-blob-with-gcc-4.1.2/$NAME)
  SIZE2=3D$(stat -c "%s" gen-blob-with-gcc-4.4.2/$NAME)
  DIFF=3D$(expr -- $SIZE2 - $SIZE1)

  TOT1=3D$(expr -- $TOT1 + $SIZE1)
  TOT2=3D$(expr -- $TOT2 + $SIZE2)
  TOTDIFF=3D$(expr -- $TOTDIFF + $DIFF)

  printf "%-30s" "$NAME"
  printf " %10d" "$SIZE1"
  printf " %10d" "$SIZE2"
  printf " %10d" "$DIFF"
  printf "\n"
done

printf "\n"
printf "%-30s" "TOTAL"
printf " %10d" "$TOT1"
printf " %10d" "$TOT2"
printf " %10d" "$TOTDIFF"
printf "\n"

