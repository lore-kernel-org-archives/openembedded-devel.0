++/* Return the section that should be marked against GC for a given
++   relocation.  */
++
++asection *
++nios2_elf32_gc_mark_hook (asection *sec,
++			  struct bfd_link_info *info ATTRIBUTE_UNUSED,
++			  Elf_Internal_Rela *rel,
