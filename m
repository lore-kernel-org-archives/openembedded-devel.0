-+	return 0;
-+}
-+
-+static int mcp_sa1100_resume(struct device *dev, u32 level)
-+{
-+	struct mcp_sa1100_state *s = (struct mcp_sa1100_state *)dev->saved_state;
-+
-+	if (s && level == RESUME_RESTORE_STATE) {
-+		Ser4MCCR1 = s->mccr1;
-+		Ser4MCCR0 = s->mccr0;
-+
-+		dev->saved_state = NULL;
-+		kfree(s);
-+	}
-+	return 0;
-+}
-+
