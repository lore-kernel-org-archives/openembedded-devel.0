++    if (new_socket.get() != invalid_socket)
++    {
++      if (peer_endpoint)
++        peer_endpoint->resize(addr_len);
++      peer.assign(impl.protocol_, new_socket.get(), ec);
++      if (!ec)
++        new_socket.release();
++    }
++
++    return ec;
