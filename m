++static int shmem_rename(struct inode *old_dir, struct dentry *old_dentry, struct inode *new_dir, struct dentry *new_dentry)
++{
++	struct inode *inode = old_dentry->d_inode;
++	int they_are_dirs = S_ISDIR(inode->i_mode);
