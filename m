++			if (remount)
++				continue;
++			sbinfo->uid = simple_strtoul(value, &rest, 0);
++			if (*rest)
++				goto bad_val;
++		} else if (!strcmp(this_char,"gid")) {
++			if (remount)
++				continue;
++			sbinfo->gid = simple_strtoul(value, &rest, 0);
++			if (*rest)
