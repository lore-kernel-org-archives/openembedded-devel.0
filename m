-+static irqreturn_t ucb1x00_irq(int irqnr, void *devid, struct pt_regs *regs)
-+{
-+	struct ucb1x00 *ucb = devid;
-+	disable_irq(irqnr);
-+	wake_up(&ucb->irq_wait);
-+	return IRQ_HANDLED;
-+}
