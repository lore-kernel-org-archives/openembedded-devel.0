++  {
++    socket_ops::setsockopt(impl.socket_, impl.state_,
++        option.level(impl.protocol_), option.name(impl.protocol_),
++        option.data(impl.protocol_), option.size(impl.protocol_), ec);
++    return ec;
++  }
