++  result = WSARecvMsg(s, &msg, &dwNumberOfBytesRecvd, NULL, NULL);
++  get_last_error(ec, true);
++  
++  if (result >= 0) {
++    ec = boost::system::error_code();
++
++    // Find destination address
++    for (LPWSACMSGHDR cmsg = WSA_CMSG_FIRSTHDR(&msg);
++         cmsg != NULL;
