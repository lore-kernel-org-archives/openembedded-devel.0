diff --git a/recipes-kernel/linux/linux-handheld-4.4/tosa/0003-tmio-call-tmiofb_set_par-in-tmiofb_probe.patch b/recipes-kernel/linux/linux-handheld-4.4/tosa/0003-tmio-call-tmiofb_set_par-in-tmiofb_probe.patch
new file mode 100644
index 0000000..37e2e74
--- /dev/null
