++static inline void detach_timer(struct timer_list *timer,
++				int clear_pending)
++{
++	struct list_head *entry = &timer->entry;
++
++	debug_deactivate(timer);
++
++	__list_del(entry->prev, entry->next);
++	if (clear_pending)
++		entry->next = NULL;
++	entry->prev = LIST_POISON2;
++}
