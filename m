++ */
++static int ethdev_init (struct net_device *dev)
++{
++  
++	if (dev->priv == NULL) 
++	{
++		struct ax_device *ax_local;
++		
++		dev->priv = kmalloc (sizeof (struct ax_device), GFP_KERNEL);
++		if (dev->priv == NULL)
++			return -ENOMEM;
++		memset (dev->priv, 0, sizeof (struct ax_device));
++		ax_local = (struct ax_device *)dev->priv;
