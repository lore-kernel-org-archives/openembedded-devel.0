-+			printk(KERN_ERR "h3600_micro : touchscreen message"
-+					" ignored, no handle \n");
-+		break;
-+	case 0x06: /* temperature */
-+		if (micro.h_temp != NULL)
-+			micro.h_temp(len, data);
-+		else
-+			printk(KERN_ERR "h3600_micro : temperature message"
-+					" ignored, no handle \n");
-+		break;
-+	case 0x09: /* battery */
