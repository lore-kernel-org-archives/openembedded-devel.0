++					host->ioaddr + MMC_STATUS);
++		}
++		fsl_writel(STATUS_WRITE_OP_DONE, host->ioaddr + MMC_STATUS);
++		pr_debug("%s: Written %u words\n", DRIVER_NAME, i);
++
++	}
++
++	/* complete the data transfer request */
++	sdhc_data_done(host, status);
