++
++static void e1000_free_rx_resources(struct e1000_adapter *adapter,
++				    struct e1000_rx_ring *rx_ring)
++{
++	struct pci_dev *pdev = adapter->pdev;
++
++	e1000_clean_rx_ring(adapter, rx_ring);
++
