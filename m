index 0000000000..367202e3c5
--- /dev/null
+++ b/meta-oe/recipes-extended/indent/indent/CVE-2023-40305_0001.patch
@@ -0,0 +1,4196 @@
+From df4ab2d19e247d059e0025789ba513418073ab6f Mon Sep 17 00:00:00 2001
+From: Petr P=EDsa=F8 <ppisar@redhat.com>
+Date: Thu, 19 Oct 2023 07:36:32 +0000
+Subject: [PATCH] Fix an out-of-buffer read in search_brace()/lexi() on an
+ condition without parentheses followed with an overlong comment
+MIME-Version: 1.0
+Content-Type: text/plain; charset=3DUTF-8
+Content-Transfer-Encoding: 8bit
+
+Reproducer:
+
+$ hexdump -C /tmp/short
+00000000  69 66 20 30 3b 65 6c 73  65 2f 2a 0a 0a 0a 0a 0a  |if 0;else/*..=
...|
+00000010  0a 0a 0a 0a 0a 0a 0a 0a  0a 0a 0a 0a 0a 0a 0a 0a  |.............=
...|
+*
+00000800  0a 0a 2a 2f 78 0a                                 |..*/x.|
+00000806
+
+$ valgrind -- ./indent -o /dev/null /tmp/short
+[...]
+=3D=3D21830=3D=3D Invalid read of size 1
+=3D=3D21830=3D=3D    at 0x40586A: lexi (lexi.c:251)
+=3D=3D21830=3D=3D    by 0x40198C: search_brace (indent.c:387)
+=3D=3D21830=3D=3D    by 0x401CC2: indent_main_loop (indent.c:548)
+=3D=3D21830=3D=3D    by 0x402298: indent (indent.c:758)
+=3D=3D21830=3D=3D    by 0x402941: indent_single_file (indent.c:1003)
+=3D=3D21830=3D=3D    by 0x402A0F: indent_all (indent.c:1041)
+=3D=3D21830=3D=3D    by 0x402BC5: main (indent.c:1122)
+=3D=3D21830=3D=3D  Address 0x4ab2210 is 0 bytes inside a block of size 2,0=
48 free'd
+=3D=3D21830=3D=3D    at 0x4847A40: realloc (vg_replace_malloc.c:1649)
+=3D=3D21830=3D=3D    by 0x408BC0: xrealloc (globs.c:64)
+=3D=3D21830=3D=3D    by 0x40BF03: need_chars (handletoken.c:89)
+=3D=3D21830=3D=3D    by 0x401433: sw_buffer (indent.c:149)
+=3D=3D21830=3D=3D    by 0x401973: search_brace (indent.c:380)
+=3D=3D21830=3D=3D    by 0x401CC2: indent_main_loop (indent.c:548)
+=3D=3D21830=3D=3D    by 0x402298: indent (indent.c:758)
+=3D=3D21830=3D=3D    by 0x402941: indent_single_file (indent.c:1003)
+=3D=3D21830=3D=3D    by 0x402A0F: indent_all (indent.c:1041)
+=3D=3D21830=3D=3D    by 0x402BC5: main (indent.c:1122)
+=3D=3D21830=3D=3D  Block was alloc'd at
+=3D=3D21830=3D=3D    at 0x4847A40: realloc (vg_replace_malloc.c:1649)
+=3D=3D21830=3D=3D    by 0x408BC0: xrealloc (globs.c:64)
+=3D=3D21830=3D=3D    by 0x40BF03: need_chars (handletoken.c:89)
+=3D=3D21830=3D=3D    by 0x401696: search_brace (indent.c:281)
+=3D=3D21830=3D=3D    by 0x401CC2: indent_main_loop (indent.c:548)
+=3D=3D21830=3D=3D    by 0x402298: indent (indent.c:758)
+=3D=3D21830=3D=3D    by 0x402941: indent_single_file (indent.c:1003)
+=3D=3D21830=3D=3D    by 0x402A0F: indent_all (indent.c:1041)
+=3D=3D21830=3D=3D    by 0x402BC5: main (indent.c:1122)
+
+The cause was that need_chars(&save_com, ...) could reallocate save_com.pt=
r
+pointer keeping a dangling copy of that pointer saved to buf_ptr
+a line above.
+
