+ #define atmel_tsadcc_write(reg, val)	__raw_writel((val), tsc_base + (re=
g))
+=20
++static unsigned int do_filter(unsigned int val[], int count, int needed=
) {
++	int i, j;
++	int max_delta, max_delta_index;
++	unsigned int average;
++
++	for (i =3D count; i > needed; i--) {
++		average =3D 0;
++		for (j =3D 0; j < i; j++)
++			average +=3D val[j];
++		average /=3D i;
++
++		max_delta =3D 0;
++		max_delta_index =3D -1;
++		for (j =3D 0; j < i; j++) {
++			if (abs(val[j] - average) > max_delta) {
++				max_delta =3D abs(val[j] - average);
++				max_delta_index =3D j;
++			}
++		}
++
++		if (max_delta_index < 0)
++			return average;
++
++		if (max_delta_index < i - 1)
++			for (j =3D 0; j < i - max_delta_index; j++)
++				val[max_delta_index + j] =3D val[max_delta_index + j + 1];
++	}
++
++	average =3D 0;
++	for (i =3D 0; i < needed; i++)
++		average +=3D val[i];
++	average /=3D needed;
++
++	return average;
++}
++
+ static irqreturn_t atmel_tsadcc_interrupt(int irq, void *dev)
+ {
