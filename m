-+short str2int (const char *str, const int &min, const int &max)
-+{
-+	int value = -1;
-+	char *endptr = NULL;
-+	if (str == NULL || str[0] == '\0')
-+		throw ArgumentException("Invalid integer option");
-+	value = strtol (str, &endptr, 10);
-+	if (*endptr != '\0' || value < min || value > max)
-+		throw ArgumentException("Invalid integer option");
-+	return value;
-+}
