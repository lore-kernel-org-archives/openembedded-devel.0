++/* Free a buffer based on bus address */
++static int FreeMemory(unsigned long busaddr)
++{
++    int i = 0;
++
++    for(i = 0; i < chunks; i++)
++    {
++        if(hlina_chunks[i].bus_address == busaddr)
++        {
++            hlina_chunks[i].used = 0;
++            hlina_chunks[i].file_id = ID_UNUSED;
++        }
++    }
++
++    return 0;
++}
