index 0000000..dc0a90f
--- /dev/null
+++ b/recipes/linux/linux-2.6.30/ronetix-pm9g45/0004-Add-CompactFlash-to-=
at91sam9g45-architecture.patch
@@ -0,0 +1,145 @@
+From 72b2a5ec84c688d9be0e398b2007d22aa360ab3c Mon Sep 17 00:00:00 2001
+From: Asen Dimov <dimov@ronetix.at>
+Date: Tue, 2 Mar 2010 01:51:37 +0200
+Subject: [[PATCH 04/22] Add CompactFlash to at91sam9g45 architecture
+
+
+Signed-off-by: Asen Chavdarov Dimov <dimov@ronetix.at>
+---
+ arch/arm/mach-at91/at91sam9g45_devices.c |  106 +++++++++++++++++++++++=
+++++++
+ drivers/pcmcia/Kconfig                   |    2 +-
+ 2 files changed, 107 insertions(+), 1 deletions(-)
+
+diff --git a/arch/arm/mach-at91/at91sam9g45_devices.c b/arch/arm/mach-at=
91/at91sam9g45_devices.c
+index 3d9c66e..26d2b72 100644
+--- a/arch/arm/mach-at91/at91sam9g45_devices.c
++++ b/arch/arm/mach-at91/at91sam9g45_devices.c
+@@ -507,6 +507,112 @@ void __init at91_add_device_mci(short mmc_id, stru=
ct mci_platform_data *data)
+ void __init at91_add_device_mci(short mmc_id, struct mci_platform_data =
*data) {}
+ #endif
+=20
++/* --------------------------------------------------------------------
++ *  Compact Flash (PCMCIA or IDE)
++ * --------------------------------------------------------------------
++ */
++
++#if defined(CONFIG_AT91_CF) || defined(CONFIG_AT91_CF_MODULE) || \
++	defined(CONFIG_BLK_DEV_IDE_AT91) || defined(CONFIG_BLK_DEV_IDE_AT91_MO=
DULE)
++
++static struct at91_cf_data cf0_data;
++
++static struct resource cf0_resources[] =3D {
++	[0] =3D {
++		.start	=3D AT91_CHIPSELECT_4,
++		.end	=3D AT91_CHIPSELECT_4 + SZ_256M - 1,
++		.flags	=3D IORESOURCE_MEM | IORESOURCE_MEM_8AND16BIT,
++	}
++};
++
++static struct platform_device cf0_device =3D {
++	.id		=3D 0,
++	.dev		=3D {
++				.platform_data	=3D &cf0_data,
++	},
++	.resource	=3D cf0_resources,
++	.num_resources	=3D ARRAY_SIZE(cf0_resources),
++};
++
++static struct at91_cf_data cf1_data;
++
++static struct resource cf1_resources[] =3D {
++	[0] =3D {
++		.start	=3D AT91_CHIPSELECT_5,
++		.end	=3D AT91_CHIPSELECT_5 + SZ_256M - 1,
++		.flags	=3D IORESOURCE_MEM | IORESOURCE_MEM_8AND16BIT,
++	}
++};
++
++static struct platform_device cf1_device =3D {
++	.id		=3D 1,
++	.dev		=3D {
++				.platform_data	=3D &cf1_data,
++	},
++	.resource	=3D cf1_resources,
++	.num_resources	=3D ARRAY_SIZE(cf1_resources),
++};
++
++void __init at91_add_device_cf(struct at91_cf_data *data)
++{
++	unsigned long csa;
++	struct platform_device *pdev;
++
++	if (!data)
++		return;
++
++	/*
++	 * assign CS4 or CS5 to SMC with Compact Flash logic support,
++	 * we assume SMC timings are configured by board code,
++	 * except True IDE where timings are controlled by driver
++	 */
++	csa =3D at91_sys_read(AT91_MATRIX_EBICSA);
++	switch (data->chipselect) {
++	case 4:
++		at91_set_A_periph(AT91_PIN_PC10, 0); /* EBI0_NCS4/CFCS0 */
++		csa |=3D AT91_MATRIX_EBI_CS4A_SMC_CF0;
++		cf0_data =3D *data;
++		pdev =3D &cf0_device;
++		break;
++	case 5:
++		at91_set_A_periph(AT91_PIN_PC11, 0); /* EBI0_NCS5/CFCS1 */
++		csa |=3D AT91_MATRIX_EBI_CS5A_SMC_CF1;
++		cf1_data =3D *data;
++		pdev =3D &cf1_device;
++		break;
++	default:
++		printk(KERN_ERR "AT91 CF: bad chip-select requested (%u)\n",
++			data->chipselect);
++		return;
++	}
++	at91_sys_write(AT91_MATRIX_EBICSA, csa);
++
++	if (data->det_pin) {
++		at91_set_gpio_input(data->det_pin, 1);
++		at91_set_deglitch(data->det_pin, 1);
++	}
++
++	if (data->irq_pin) {
++		at91_set_gpio_input(data->irq_pin, 1);
++		at91_set_deglitch(data->irq_pin, 1);
++	}
++
++	if (data->vcc_pin)
++		/* initially off */
++		at91_set_gpio_output(data->vcc_pin, 0);
++
++	/* enable EBI controlled pins */
++	at91_set_A_periph(AT91_PIN_PC15, 0); /* NWAIT */
++	at91_set_A_periph(AT91_PIN_PC8, 0); /* CFCE1 */
++	at91_set_A_periph(AT91_PIN_PC9, 0); /* CFCE2 */
++	at91_set_A_periph(AT91_PIN_PC12, 0); /* CFNRW */
++
++	pdev->name =3D (data->flags & AT91_CF_TRUE_IDE) ? "at91_ide" : "at91_c=
f";
++	platform_device_register(pdev);
++}
++#else
++void __init at91_add_device_cf(struct at91_cf_data *data) {}
++#endif
+=20
+ /* --------------------------------------------------------------------
+  *  NAND / SmartMedia
+diff --git a/drivers/pcmcia/Kconfig b/drivers/pcmcia/Kconfig
+index e42d141..5790c67 100644
+--- a/drivers/pcmcia/Kconfig
++++ b/drivers/pcmcia/Kconfig
+@@ -270,7 +270,7 @@ config BFIN_CFPCMCIA
+=20
+ config AT91_CF
+ 	tristate "AT91 CompactFlash Controller"
+-	depends on PCMCIA && (ARCH_AT91RM9200 || ARCH_AT91SAM9260 || ARCH_AT91=
SAM9G20)
++	depends on PCMCIA && (ARCH_AT91RM9200 || ARCH_AT91SAM9260 || ARCH_AT91=
SAM9G20 || ARCH_AT91SAM9G45)
+ 	help
+ 	  Say Y here to support the CompactFlash controller on AT91 chips.
+ 	  Or choose M to compile the driver as a module named "at91_cf".
+--=20
+1.7.4.4
+
