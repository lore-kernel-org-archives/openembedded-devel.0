+=3D=3D21830=3D=3D    by 0x408BC0: xrealloc (globs.c:64)
+=3D=3D21830=3D=3D    by 0x40BF03: need_chars (handletoken.c:89)
+=3D=3D21830=3D=3D    by 0x401696: search_brace (indent.c:281)
+=3D=3D21830=3D=3D    by 0x401CC2: indent_main_loop (indent.c:548)
+=3D=3D21830=3D=3D    by 0x402298: indent (indent.c:758)
