diff --git a/meta-oe/recipes-devtools/breakpad/breakpad/0017-Mac-don-t-call-NXFindBestFatArch.patch b/meta-oe/recipes-devtools/breakpad/breakpad/0017-Mac-don-t-call-NXFindBestFatArch.patch
