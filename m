itstool gnome-help gsettings gtk-icon-cache mime-xdg features_check
+
+REQUIRED_DISTRO_FEATURES =3D "opengl"
+
+GTKIC_VERSION =3D "4"
+
+SRC_URI =3D "git://gitlab.gnome.org/GNOME/loupe.git;protocol=3Dhttps;bra=
nch=3Dmain;tag=3D${PV} \
