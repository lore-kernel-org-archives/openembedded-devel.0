++static void bdi_task_init(struct backing_dev_info *bdi,
++			  struct bdi_writeback *wb)
++{
++	struct task_struct *tsk = current;
++
++	spin_lock(&bdi->wb_lock);
++	list_add_tail_rcu(&wb->list, &bdi->wb_list);
++	spin_unlock(&bdi->wb_lock);
