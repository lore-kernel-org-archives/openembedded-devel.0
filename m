+ obj-$(CONFIG_VT)		  += console/
+ obj-$(CONFIG_LOGO)		  += logo/
+-obj-y				  += backlight/
+ 
+ obj-$(CONFIG_EXYNOS_VIDEO)     += exynos/
+ 
+@@ -177,3 +176,5 @@ obj-$(CONFIG_VIDEOMODE_HELPERS) += display_timing.o videomode.o
+ ifeq ($(CONFIG_OF),y)
