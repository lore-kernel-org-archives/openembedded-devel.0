-+		ucb1x00_enable(ucb);
-+		ucb1x00_reg_write(ucb, UCB_IE_RIS, ucb->irq_ris_enbl);
-+		ucb1x00_reg_write(ucb, UCB_IE_FAL, ucb->irq_fal_enbl);
-+		ucb1x00_disable(ucb);
-+
-+		irq->fn = NULL;
-+		irq->devid = NULL;
-+		ret = 0;
-+	}
-+	spin_unlock_irq(&ucb->lock);
