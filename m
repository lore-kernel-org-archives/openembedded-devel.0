++        lwz     r5, 0(r4)
++        stw     r5, 0(r3)
++        addi    r3, r3, 4
++        addi    r4, r4, 4
++        bdnz    loop
++
++	/* Copy code to Location 0x0 */
++	mr	r4, r6
++	li	r3, (code_atzero_end - code_atzero)/4
++	mtctr	r3
++	lis	r3, code_atzero@h
++	ori	r3, r3, code_atzero@l
