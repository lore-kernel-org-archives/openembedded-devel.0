++			/* wait for buffers to be ready for read */
++
++			count = 0;
++			while (!(fsl_readl(host->ioaddr + MMC_STATUS) &
++						(STATUS_BUF_READ_RDY |
++						 STATUS_READ_OP_DONE))) {
++			count++;
