++
++	NIC_PHY_CONTROL_REG0 = ((phy_addr & 0x1F) | 
++		((phy_reg & 0x1F) << 8) | 
++		(0x1 << 14));    
++
++	for (i = 0; i < 10000; i++) {
++		status = NIC_PHY_CONTROL_REG0;
++		if (status & (0x1 << 15)) {
++			// clear the rw_ok status, and clear other bits value
++			NIC_PHY_CONTROL_REG0 = (0x1 << 15);
++			*read_data = (u16)((status >> 16) & 0xFFFF);
++			return (0);    /* for ok indication */
