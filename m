++                                               ".rela.got",
++                                               (SEC_ALLOC | SEC_LOAD
++                                                | SEC_HAS_CONTENTS
++                                                | SEC_IN_MEMORY
++                                                | SEC_LINKER_CREATED
++                                                | SEC_READONLY));
