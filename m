#include <dlfcn.h>
#include <stdio.h>
#include <stdlib.h>


int main(int argc, char** argv)
{
    if (argc != 2) {
        fprintf(stderr, "Pass an object to open\n");
        return -1;
    }

    void* library = dlopen(argv[1], RTLD_LAZY);
    printf("Success, didn't crash\n");

    return 0;
}

