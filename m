++        lwz     r5, 0(r3)
++        stw     r5, 0(r4)
++        addi    r3, r3, 4
++        addi    r4, r4, 4
++        bdnz    loop1
++	blr
++
++code_atzero:
++	.long 0x0  /*Space reserved for copying first word of code from 0x500 */
++	ba 0x504
++	ba 0xc  /* This code is not executed. This code is copied to 0x500 */
