++
++  masks[4] = msk4;
++  masks[5] = msk4;
++  masks[6] = msk4;
++  masks[7] = msk4;
++
++  for (i=0; i < 8; i++)
++    {
++      tmp = val2;
++      tmp.f[(masks[i] & 0x30) >> 4] = val1.f[(masks[i] & 0xC0) >> 6];
