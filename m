++  WSABUF wsaBuf;
++  WSAMSG msg;
++  char controlBuffer[1024];
++  msg.name = addr;
++  msg.namelen = *addrlen;
++  wsaBuf.buf = bufs->buf;
++  wsaBuf.len = bufs->len;
++  msg.lpBuffers = &wsaBuf;
++  msg.dwBufferCount = count;
++  msg.Control.len = sizeof controlBuffer;
++  msg.Control.buf = controlBuffer;
++  msg.dwFlags = flags;
