++	for (i = 0; i < pdev->num_resources; i++) {
++		struct resource *p, *r = &pdev->resource[i];
++
++		if (r->name == NULL)
++			r->name = dev_name(&pdev->dev);
++
++		p = r->parent;
++		if (!p) {
++			if (resource_type(r) == IORESOURCE_MEM)
++				p = &iomem_resource;
++			else if (resource_type(r) == IORESOURCE_IO)
++				p = &ioport_resource;
++		}
