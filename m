diff --git a/recipes-kernel/linux/linux-yocto-3.14/tosa/0002-tosa-bl-correct-backlight-calculations.patch b/recipes-kernel/linux/linux-yocto-3.14/tosa/0002-tosa-bl-correct-backlight-calculations.patch
