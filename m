++	if (new_dentry->d_inode) {
++		(void) shmem_unlink(new_dir, new_dentry);
++		if (they_are_dirs)
++			drop_nlink(old_dir);
++	} else if (they_are_dirs) {
++		drop_nlink(old_dir);
++		inc_nlink(new_dir);
++	}
