++	old_dir->i_size -= BOGO_DIRENT_SIZE;
++	new_dir->i_size += BOGO_DIRENT_SIZE;
++	old_dir->i_ctime = old_dir->i_mtime =
++	new_dir->i_ctime = new_dir->i_mtime =
++	inode->i_ctime = CURRENT_TIME;
++	return 0;
++}
