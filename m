++			if (cs_change) {
++				bitbang->chipselect(spi, BITBANG_CS_ACTIVE);
++				ndelay(nsecs);
++			}
++			cs_change = t->cs_change;
++			if (!t->tx_buf && !t->rx_buf && t->len) {
++				status = -EINVAL;
++				break;
++			}
++
++			/* transfer data.  the lower level code handles any
++			 * new dma mappings it needs. our caller always gave
++			 * us dma-safe buffers.
++			 */
++			if (t->len) {
