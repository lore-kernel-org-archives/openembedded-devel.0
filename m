+	Option		"ReportingMode"		"Raw"
+EndSection
+
+Section "InputDevice"
+        Identifier  "Keyboard"
+        Driver      "kbd"
+        Option      "XkbLayout" "us"
+        Option      "XkbModel"  "htcdream"
