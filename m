++	low = (dev->dev_addr[2] << 24) | (dev->dev_addr[3] << 16) | (dev->dev_addr[4] << 8) | (dev->dev_addr[5]);
++	high = (dev->dev_addr[0] << 8) | (dev->dev_addr[1]);
++
++	ks8695_write(dev, KS8695_WMAL, low);
++	ks8695_write(dev, KS8695_WMAH, high);
++}
