++ */
++int platform_device_add(struct platform_device *pdev)
++{
++	int i, ret = 0;
++
++	if (!pdev)
++		return -EINVAL;
++
++	if (!pdev->dev.parent)
++		pdev->dev.parent = &platform_bus;
++
++	pdev->dev.bus = &platform_bus_type;
++
++	if (pdev->id != -1)
++		dev_set_name(&pdev->dev, "%s.%d", pdev->name,  pdev->id);
++	else
++		dev_set_name(&pdev->dev, "%s", pdev->name);
