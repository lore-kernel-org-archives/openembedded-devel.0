-+	unsigned long events = 0;
-+
-+	spin_lock(&rtc_lock);
-+
-+	rtsr = RTSR;
-+	/* clear interrupt sources */
-+	RTSR = 0;
-+	RTSR = (RTSR_AL|RTSR_HZ) & (rtsr >> 2);
