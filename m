++#ifdef CONFIG_MMU
++	unsigned long user_size, kern_size;
++	struct arm_vmregion *c;
++
++	user_size = (vma->vm_end - vma->vm_start) >> PAGE_SHIFT;
++
++	c = arm_vmregion_find(&consistent_head, (unsigned long)cpu_addr);
