-+	return 0;
-+}
-+
-+static int micro_batt_resume(struct platform_device *pdev)
-+{
-+	/*--- timer ---*/
-+	add_timer(&batt_timer);
-+
-+	return 0;
-+}
-+
-+struct platform_driver micro_batt_device_driver = {
-+	.driver		= {
-+		.name	= "h3600-micro-battery",
-+	},
-+	.probe		= micro_batt_probe,
