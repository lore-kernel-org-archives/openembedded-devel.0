+Section "Monitor"
+	Identifier "Monitor0"
+	Mode "320x480"
+        	DotClock 0		
+		HTimings 320 320 320 320
+		VTimings 480 480 480 480
+		Flags    "-HSync" "-VSync"
+	EndMode
+EndSection    
+
+Section "Device"                                  
