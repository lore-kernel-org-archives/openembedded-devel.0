diff --git a/recipes-kernel/linux/linux-handheld-4.4/locomo/0005-video-backlight-add-new-locomo-backlight-driver.patch b/recipes-kernel/linux/linux-handheld-4.4/locomo/0005-video-backlight-add-new-locomo-backlight-driver.patch
