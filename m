++static inline u16 READ_FIFO (void *membase)
++{
++	return (readb (membase) | (((u16)readb (membase)) << 8));
++}
++
++static inline void WRITE_FIFO (void *membase, u16 data)
++{
++	writeb ((u8)data , membase);
++	writeb ((u8)(data >> 8) , membase);
++}
++#else
++static inline u16 READ_FIFO (void *membase)
++{
++	return readw (membase);
++}
++
++static inline void WRITE_FIFO (void *membase, u16 data)
++{
++	writew (data, membase);
