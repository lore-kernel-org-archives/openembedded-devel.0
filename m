++/* one-time init, only for memory state */
++static int ehci_init(struct usb_hcd *hcd)
++{
++	struct ehci_hcd		*ehci = hcd_to_ehci(hcd);
++	u32			temp;
++	int			retval;
++	u32			hcc_params;
++	struct ehci_qh_hw	*hw;
++
++	spin_lock_init(&ehci->lock);
