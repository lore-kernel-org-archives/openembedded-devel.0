+ #if defined(__i386__)
+   arch = kArch_i386;
+@@ -222,7 +180,8 @@ const NXArchInfo *NXGetLocalArchInfo(void) {
+ #else
+   #error "Unsupported CPU architecture"
+ #endif
+-  return &kKnownArchitectures[arch];
++  NXArchInfo info = kKnownArchitectures[arch];
++  return {info.cputype, info.cpusubtype};
+ }
